# Cell AI Environment Configuration
# Copy this file to .env and fill in your values

# Path to your 6TB hard drive for training data and model checkpoints
# Windows example:  DATA_ROOT=E:\cellai_data
# Linux example:    DATA_ROOT=/mnt/cellai_data
DATA_ROOT=E:\cellai_data

# Optional: override compute device (auto-detected if not set)
# CELLAI_DEVICE=cuda
# CELLAI_DEVICE=cpu
