# Cypha — Comprehensive .gitignore for the Cypha/HRNA Universe

# =====================================================
# NEVER UPLOAD TO GIT — Large Binary & Data Files
# =====================================================

# =====================================================
# Large Dataset & Model Files
# =====================================================

# Neural network weights (source-only repo — users generate these)
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.npz
*.npy
models/
weights/
checkpoints/
snapshots/
training/
experiment/
experiments/

# =====================================================
# Log Files
# =====================================================

# Log files (text-based but large)
logs/*.log
logs/*.txt
*.log
logs/

# =====================================================
# Python Cache & Bytecode
# =====================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/

# =====================================================
# Python Environment
# =====================================================

# Python virtual environment (install with pip, not commit)
.venv/
venv/
ENV/
env/

# =====================================================
# IDE Files (Don't Share These)
# =====================================================

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# =====================================================
# Cypha-Specific Exclusions
# =====================================================

# Cypha-specific data files (large)
bessel_ratios.npz
*.npz
bessel_ratios.npz
*.bin

# Config files (keep only examples)
config/*.jsonl
config/*.yaml
config/*.yml

# =====================================================
# Build Artifacts
# =====================================================

# Build artifacts
build/
dist/
*.egg-info/
*.egg
MANIFEST
*.so
*.pyd

# =====================================================
# Temporary Files
# =====================================================

# Temporary files
*.tmp
*.bak
*.backup
*.cache
*.tmp
*.swp
*.swo
*~

# =====================================================
# Documentation Build Artifacts (Optional)
# =====================================================

# If you want to generate docs locally, exclude generated files:
docs/site/
*.html
*.md.html
*_test.html
*_demo.html
*.pickle
*.joblib

# =====================================================
# Environment & Configuration (Local Only)
# =====================================================

.env
.env.local
.env.*.local
*.pem
*.key
*.secret
*.sh
*.bash_history

# =====================================================
# Notes for Cypha .gitignore
# =====================================================

# This .gitignore is designed to:
# - Prevent uploading gigabytes of data (models, logs, data files)
# - Keep only source code, documentation, and configuration
# - Exclude build artifacts and temporary files
# - Exclude environment configurations

# IMPORTANT:
# - Cypha.py, Cypha.py — ARE tracked
# - Markdown files (.md) — ARE tracked
# - Research papers (.pdf) — ARE tracked
# - Only binary, cache, and generated files are ignored